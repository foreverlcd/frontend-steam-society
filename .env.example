# URL base de la API, incluyendo el prefijo /v1.
# En local, el backend NestJS corre en el puerto 3000.
NEXT_PUBLIC_API_URL="http://localhost:3000/v1"

# URL pública de esta web, sin "/" final. La usan canonical, sitemap, robots,
# llms.txt y las tarjetas para redes. En producción: https://APP_DOMAIN.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Contacto de soporte que se muestra en /help y al reportar (opcional).
NEXT_PUBLIC_SUPPORT_EMAIL=""
# WhatsApp con código de país, sin "+" ni espacios (ej. 51987654321).
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
